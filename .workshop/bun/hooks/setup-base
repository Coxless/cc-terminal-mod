# root で実行される。Bun の公式リリースを /usr/local/bin に入れる。
# バージョンを上げるときは BUN_VERSION を変えて `workshop refresh`。
set -eu

BUN_VERSION="${BUN_VERSION:-1.4.2}"

case "$(uname -m)" in
  x86_64)  BUN_ARCH=x64 ;;
  aarch64) BUN_ARCH=aarch64 ;;
  *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

apt-get update
# git は bun install の git 依存用。vim はテストで alternate screen を確かめるのに使う。
eatmydata apt-get install -y curl ca-certificates unzip git vim

if [ "$(bun --version 2>/dev/null || true)" != "$BUN_VERSION" ]; then
  tmp=$(mktemp -d)
  base="https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}"
  zip="bun-linux-${BUN_ARCH}.zip"
  curl -fsSL -o "$tmp/$zip" "$base/$zip"
  curl -fsSL -o "$tmp/SHASUMS256.txt" "$base/SHASUMS256.txt"
  (cd "$tmp" && grep " $zip\$" SHASUMS256.txt | sha256sum -c -)
  unzip -q "$tmp/$zip" -d "$tmp"
  install -m 0755 "$tmp/bun-linux-${BUN_ARCH}/bun" /usr/local/bin/bun
  ln -sf bun /usr/local/bin/bunx
  rm -rf "$tmp"
fi
